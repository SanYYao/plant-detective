# 本地开发环境变量（`wrangler pages dev` 会读这个文件）
#
# 用法：复制成 .dev.vars 再填真实值。
#   cp .dev.vars.example .dev.vars
#
# .dev.vars 已被 .gitignore 排除，绝不会进 git / GitHub。

# ── OpenRouter API Key ───────────────────────────────
# 只用于小绿 AI 答疑。申请后填这里（生产环境填到 Cloudflare Pages 后台）
OPENROUTER_KEY=

# ── 小绿认证编号（PIN）────────────────────────────────
# 6 位数字。前端永远看不到它；只在边缘端和这个文件里存在。
AI_PIN=

# ── 可选：聊天模型 ───────────────────────────────────
# 默认 google/gemini-3-flash（注意：这是聊天模型，不是生图模型）
AI_MODEL=google/gemini-3-flash
